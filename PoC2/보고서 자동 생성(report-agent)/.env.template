# Report Auto-Generation Agent PoC (.env.template)
# 1) Copy this file to .env
# 2) Set OPENAI_API_KEY

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_TIMEOUT_SECONDS=60

# Existing report corpus
REPORT_CORPUS_DIR=.\data\existing_reports

# Web server
HOST=127.0.0.1
PORT=8010

# Retrieval
TOP_K=5

# Output
OUTPUT_DIR=.\outputs

# Article extraction
# If URL fetch fails, UI should use pasted body.
USER_AGENT=Mozilla/5.0 (AX PoC)
