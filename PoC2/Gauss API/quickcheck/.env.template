# Gauss Chat APIs (OpenAPI) quick check
# 1) Copy this file to .env
# 2) Fill in values

# Base endpoint issued when you apply for OpenAPI (NO trailing slash)
# Example: https://<your-domain>
ENDPOINT_URL=

# Required headers
x-generative-ai-client=
# Example: Bearer eyJ...
x-openapi-token=

# Optional (recommended)
x-generative-ai-user-email=

# Optional convenience
# You can set this after running: python gauss_quickcheck.py models
GAUSS_TEXT_MODEL_ID=

# Optional: default prompt
DEFAULT_PROMPT=안녕하세요. 지금 Gauss Chat API 연결 테스트 중입니다.
