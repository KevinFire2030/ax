# Gauss Chat APIs (OpenAPI) adapter config
# 1) Copy this file to .env
# 2) Fill in values

# Base endpoint issued when you apply for OpenAPI (NO trailing slash)
ENDPOINT_URL=

# Required headers
x-generative-ai-client=
# Example: Bearer eyJ...
x-openapi-token=

# Optional
x-generative-ai-user-email=

# Default model (PoC default: GaussO)
# You can find modelId via: ../quickcheck/gauss_quickcheck.py models
GAUSS_TEXT_MODEL_ID=

# Default prompts
DEFAULT_SYSTEM_PROMPT=당신은 사내 업무 점검을 돕는 비서입니다. 사용자의 요청에 정확하고 간결하게 답하세요.

# Networking
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF_SECONDS=1.5
