# .env.template for context-based post-detection PoC
# 1) Put your OpenAI key:
# OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_SECONDS=2.0
OPENAI_CONCURRENCY=5

# Candidate selection
CANDIDATE_RATIO=0.05
CANDIDATE_MIN_ROWS=20
CANDIDATE_MAX_ROWS=10000

# Hit threshold
HIT_RISK_LEVEL_THRESHOLD=4
HIT_RISK_SCORE_THRESHOLD=60

# Column mapping
COL_TITLE=제목
COL_BODY=본문내용
COL_ATTACH_SAMSUNG=일반자료명: 삼성등록
COL_ATTACH_VENDOR=일반자료명: 협력사등록
COL_DEPT=발신자부서명

# Output
OUTPUT_XLSX_NAME=context_based_detection_by_dept.xlsx
OUTPUT_SPLIT_BY_DEPT=true
OUTPUT_INCLUDE_SHEET1=true

# Prompt & keywords
PROMPT_FILE_PATH=.\prompt_context_detection.md
KEYWORD_FILE_PATH=.\detection_keywords.md

# Cache
CACHE_ENABLED=true
CACHE_DIR=.\cache_context_detection
CACHE_KEY_COL=전송코드

# Body trimming
BASE64_PLACEHOLDER=<BASE64_IMAGE>
BODY_MAX_CHARS=10000
BODY_TRIM_MODE=head_tail
