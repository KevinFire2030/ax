# .env.template for context-based post-detection PoC

# LLM provider: gauss | openai
LLM_PROVIDER=gauss

# -------------------------
# GAUSS Chat APIs(OpenAPI)
# -------------------------
# Base endpoint issued when you apply for OpenAPI (NO trailing slash)
ENDPOINT_URL=

# Required headers
x-generative-ai-client=
# Example: Bearer eyJ...
x-openapi-token=

# Optional
x-generative-ai-user-email=

# Default text modelId (PoC default: GaussO)
GAUSS_TEXT_MODEL_ID=

# Optional system prompt for GAUSS
GAUSS_SYSTEM_PROMPT=

# -------------------------
# OpenAI (only if LLM_PROVIDER=openai)
# -------------------------
# OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_SECONDS=2.0
OPENAI_CONCURRENCY=1

# Candidate selection (PoC: GAUSS 3 req/min 가정 → 1건만 태워서 데모)
CANDIDATE_RATIO=0.01
CANDIDATE_MIN_ROWS=1
CANDIDATE_MAX_ROWS=1

# Hit threshold
HIT_RISK_LEVEL_THRESHOLD=4
HIT_RISK_SCORE_THRESHOLD=60

# Column mapping
COL_TITLE=제목
COL_BODY=본문내용
COL_ATTACH_SAMSUNG=일반자료명: 삼성등록
COL_ATTACH_VENDOR=일반자료명: 협력사등록
COL_DEPT=발신자부서명

# Output
OUTPUT_XLSX_NAME=context_based_detection_by_dept.xlsx
OUTPUT_SPLIT_BY_DEPT=true
OUTPUT_INCLUDE_SHEET1=true

# Prompt & keywords
PROMPT_FILE_PATH=.\prompt_context_detection.md
KEYWORD_FILE_PATH=.\detection_keywords.md

# Cache
CACHE_ENABLED=true
CACHE_DIR=.\cache_context_detection
CACHE_KEY_COL=전송코드

# Body trimming
BASE64_PLACEHOLDER=<BASE64_IMAGE>
BODY_MAX_CHARS=10000
BODY_TRIM_MODE=head_tail
