# PoC3 Context WebUI
# Copy to .env and fill.

# Bind/port for internal access
HOST=0.0.0.0
PORT=8000

# Sample xlsx path (DRM: no upload; server reads this file)
SAMPLE_XLSX_PATH=
SAMPLE_SHEET=0

# Column mapping (same as PoC2)
COL_TITLE=제목
COL_BODY=본문내용
COL_ATTACH_SAMSUNG=일반자료명: 삼성등록
COL_ATTACH_VENDOR=일반자료명: 협력사등록
COL_DEPT=발신자부서명
CACHE_KEY_COL=전송코드

# Candidate selection
CANDIDATE_RATIO=0.05
CANDIDATE_MIN_ROWS=1
CANDIDATE_MAX_ROWS=10

# Hit threshold
HIT_RISK_LEVEL_THRESHOLD=4

# Keyword/prompt default files
KEYWORD_FILE_PATH=./detection_keywords.md
PROMPT_FILE_PATH=./prompt_context_detection.md

# Cache
CACHE_ENABLED=true
CACHE_DIR=./cache_context_detection

# LLM provider: gauss | openai
LLM_PROVIDER=gauss

# ---- GAUSS ----
GAUSS_ENDPOINT_URL=
GAUSS_CLIENT_HEADER=
GAUSS_TOKEN_HEADER=
GAUSS_USER_EMAIL=
GAUSS_TEXT_MODEL_ID=
GAUSS_SYSTEM_PROMPT=
GAUSS_RPM=3

# ---- OpenAI compatible ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=2.0

# Rate limit (applies to both providers if set)
# If empty, derived from GAUSS_RPM for gauss, else 0 (no pacing)
RPM=
