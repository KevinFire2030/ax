#############################################
# CPCex Internal Pre-check PoC (.env.template)
# - CPCex 서버 코드(전송 직전)에서 LLM을 직접 호출하는 방식
# - 실제 운영에서는 Secret Manager 사용 권장
#############################################

# OpenAI API Key (필수)
OPENAI_API_KEY=

# 모델
OPENAI_MODEL=gpt-5.2

# 일관성 위주(낮게 권장)
OPENAI_TEMPERATURE=0.1

# 응답 토큰(근거+JSON)
OPENAI_MAX_OUTPUT_TOKENS=1200

# 타임아웃(초): 전송 직전이므로 2~5초 권장
OPENAI_TIMEOUT_SECONDS=5

# 실패/지연 시 기본정책 (allow|warn|block)
# 사전차단 PoC에서는 보통 warn 권장(업무 중단 방지)
FAIL_OPEN_POLICY=warn

# 정책 임계값
WARN_RISK_LEVEL_THRESHOLD=2
BLOCK_RISK_LEVEL_THRESHOLD=4

# 프롬프트/승인 라우팅
PROMPT_FILE_PATH=.\prompt_context_detection.md
APPROVAL_ROUTING_PATH=.\approval_routing.json

# (옵션) 결과 캐시(첨부가 내용 없이 파일명/확장자만이라면 캐시 효용 큼)
CACHE_ENABLED=true
CACHE_DIR=.\cache_internal
CACHE_KEY_COL=전송코드
